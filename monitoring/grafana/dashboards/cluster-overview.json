{
  "title": "Multi-Node Cluster Overview",
  "uid": "cluster-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Host CPU usage (node-exporter)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Host memory used %",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "100 * (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes))",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Ray Serve: requests in flight per replica",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "Exact Ray metric names vary by Ray version - check /metrics on ray-head:8080 and adjust this query to match (see ray-cluster/README.md).",
      "targets": [
        {
          "expr": "ray_serve_num_ongoing_http_requests",
          "legendFormat": "{{deployment}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "GPU utilization % (DCGM, requires real GPU host)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "Populated once dcgm-exporter is enabled in monitoring/docker-compose.yml on a machine with an NVIDIA GPU.",
      "targets": [
        {
          "expr": "DCGM_FI_DEV_GPU_UTIL",
          "legendFormat": "gpu {{gpu}}"
        }
      ]
    }
  ]
}
